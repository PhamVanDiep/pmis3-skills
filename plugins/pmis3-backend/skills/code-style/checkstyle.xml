<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Quy định style chung backend PMIS3 — bản gốc ở skill pmis3-backend:code-style (repo pmis3-skills).
    Spotless (palantir-java-format) lo định dạng, kể cả thụt lề 4 dấu cách — không bật module Indentation
    vì nó lệch với formatter ở switch-case "->" và lambda lồng. File này chặn các lỗi formatter không tự sửa
    được: tab, dòng quá 120 ký tự, thiếu {}, import thừa, lỗi logic dễ mắc.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressWarningsFilter"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf_cr_crlf"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Dòng có khoảng trắng thừa ở cuối."/>
    </module>
    <module name="LineLength">
        <property name="max" value="120"/>
        <!-- Bỏ qua dòng chỉ chứa chuỗi (mô tả Swagger, thông báo) vì formatter không ngắt được chuỗi. -->
        <property name="ignorePattern" value="^(package|import) |^\s*(\*|//).*https?://|^\s*\+?\s*&quot;.*&quot;[\s,);]*$"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Import -->
        <!-- Cho phép import * (IntelliJ tự gộp khi >= 5 class cùng package). -->
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport"/>

        <!-- Khối lệnh -->
        <module name="NeedBraces">
            <!-- Cho phép lệnh ngắn cùng dòng: if (x == null) return; -->
            <property name="allowSingleLineStatement" value="true"/>
        </module>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="EmptyStatement"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <!-- Khai báo -->
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="ModifierOrder"/>
        <module name="OuterTypeFilename"/>
        <module name="OneTopLevelClass"/>
        <module name="PackageDeclaration"/>

        <!-- Đặt tên -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9_]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="ConstantName">
            <!-- Cho phép logger viết thường: private static final Logger log -->
            <property name="format" value="^(log|logger|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="StaticVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="CatchParameterName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>
        <module name="InterfaceTypeParameterName"/>
        <module name="AbbreviationAsWordInName">
            <!-- Tối đa 4 chữ hoa liền nhau trong tên (ORGID, EVNID ok); hằng static final không tính. -->
            <property name="allowedAbbreviationLength" value="4"/>
        </module>

        <!-- Lỗi dễ mắc -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="DefaultComesLast"/>
        <module name="CovariantEquals"/>
    </module>
</module>
